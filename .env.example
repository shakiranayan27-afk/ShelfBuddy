# Copy this file to `.env` and fill in values.
# The real .env is git-ignored and read ONLY by the backend (server-side).
# No secret is ever exposed to the browser, logs, or committed files.

# Backend port
PORT=3001

# --- Google Gemini (Stage 2) ---
# Get a key from https://aistudio.google.com/apikey
# Put the real value in .env (NOT here). Never commit the real key.
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-3.5-flash-lite
